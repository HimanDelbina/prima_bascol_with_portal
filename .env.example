# ==============================================================================
# Prima Bascol - Production Environment Variables Configuration Template
# سامانه جامع و پیشرفته باسکول صنعتی پریما
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the required production values (especially strong SECRET_KEY and DB password).
# 3. Ensure .env is never committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Generate a strong, random 50+ character key, e.g.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate_and_place_a_secure_random_key_here_minimum_50_chars

# Production MUST always be False
DJANGO_DEBUG=False

# Allowed Hostnames (comma-separated)
# Include your internal server IP if direct IP access is needed (e.g. 192.168.10.50)
DJANGO_ALLOWED_HOSTS=bascol.ferion.ir,www.bascol.ferion.ir,127.0.0.1,localhost,web

# Optional: Dedicated Internal / LAN IP(s) for the server (comma-separated)
# If provided, this IP is automatically added to ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, and CORS_ALLOWED_ORIGINS
# DJANGO_INTERNAL_IPS=192.168.10.50

# CSRF Trusted Origins (comma-separated with scheme https:// or http://)
# Note: In HTTPS environments, use https://. Internal IPs configured in DJANGO_INTERNAL_IPS are added automatically.
DJANGO_CSRF_TRUSTED_ORIGINS=https://bascol.ferion.ir,https://www.bascol.ferion.ir

# CORS Allowed Origins (comma-separated with scheme https:// or http://)
DJANGO_CORS_ALLOWED_ORIGINS=https://bascol.ferion.ir,https://www.bascol.ferion.ir

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=prima_bascol
POSTGRES_USER=bascol_admin
POSTGRES_PASSWORD=replace_with_strong_database_password_123!
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# ------------------------------------------------------------------------------
# Optional: defaults to DJANGO_SECRET_KEY if left blank
DJANGO_JWT_SECRET_KEY=

# ------------------------------------------------------------------------------
# Security, SSL & Cookie Settings (Reverse Proxy / HTTPS / HTTP)
# ------------------------------------------------------------------------------
# HSTS Header in seconds (3600 = 1 hour, 31536000 = 1 year). Start with 3600 during initial setup.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Keep False because Nginx / Nginx Proxy Manager performs the SSL redirect:
DJANGO_SECURE_SSL_REDIRECT=False

# Cookie Security Flags (CRITICAL FOR AUTHENTICATION):
# In production, both domain and LAN IP access terminate TLS at Nginx Proxy Manager
# (Let's Encrypt for bascol.ferion.ir, Private CA with IP SAN for https://<LAN_IP>).
# Cookies are strictly marked Secure=True and HttpOnly=True across both pathways.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# Gunicorn & Server Performance
# ------------------------------------------------------------------------------
# Number of Gunicorn worker processes (Recommended: 2 x CPU cores + 1)
WEB_CONCURRENCY=3

# Host Port Binding for Web Service:
# 127.0.0.1:8000:8000 (Mandatory): Binds strictly to localhost, accessible ONLY via Reverse Proxy (NPM).
# Gunicorn must NEVER be directly exposed to the LAN or 0.0.0.0 to prevent X-Forwarded-* header spoofing.
WEB_BIND_PORT=127.0.0.1:8000:8000

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Options: INFO, WARNING, ERROR, DEBUG
DJANGO_LOG_LEVEL=INFO
